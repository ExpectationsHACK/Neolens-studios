# --- Core ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-string

# --- Database (Postgres) ---
# Free options: Neon (neon.tech) or Supabase (supabase.com)
DATABASE_URL=postgresql://user:password@host:5432/neolensstudios

# --- Cloudflare R2 (video/media storage — free tier: 10GB storage, zero egress) ---
# Create a bucket + API token at dash.cloudflare.com > R2
R2_BUCKET=neolensstudios-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Either a bucket with public access enabled, or a custom domain mapped to it
R2_PUBLIC_URL=https://media.neolensstudios.com

# --- Email notifications for new leads + prospect confirmations ---
# resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=hello@neolensstudios.com

# --- Contact form spam protection (Cloudflare Turnstile — free) ---
# Create a widget at dash.cloudflare.com > Turnstile. Without these, the
# form still works but only the honeypot + rate limit protect it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (Google Analytics 4 — free) ---
# Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# --- Booking link (Cal.com — free tier) ---
# Shown as "Book a call instead" on /contact when set, e.g.
# https://cal.com/your-handle/intro-call
NEXT_PUBLIC_CAL_LINK=

# --- Error monitoring (Sentry — free tier) ---
# Leave blank to disable entirely (no Sentry code runs without a DSN).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Seed script (npm run seed) ---
# Credentials for the one admin user the seed script creates. Change the
# password after first login.
SEED_ADMIN_EMAIL=admin@neolensstudios.com
SEED_ADMIN_PASSWORD=change-me-now-123!
